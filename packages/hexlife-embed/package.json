{
  "name": "@hexlife/embed",
  "version": "1.11.0",
  "description": "Embeddable binary, k-state, and stochastic hexagonal cellular-automaton engines, with a solid extruder for 3D printing",
  "keywords": [
    "cellular-automata",
    "hexagonal",
    "hex-grid",
    "simulation",
    "artificial-life",
    "game-of-life",
    "lattice-gas",
    "webassembly",
    "wasm",
    "webgl2",
    "web-components",
    "custom-elements",
    "deterministic",
    "generative-art",
    "3d-printing",
    "stl",
    "3mf",
    "mesh"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Sidem",
  "sideEffects": [
    "./src/embed/index.js",
    "./src/embed/ca-element.js",
    "./src/embed/stochastic-element.js"
  ],
  "exports": {
    ".": {
      "types": "./src/embed/index.d.ts",
      "import": "./src/embed/index.js",
      "default": "./src/embed/index.js"
    },
    "./api": {
      "types": "./src/embed/api.d.ts",
      "import": "./src/embed/api.js",
      "default": "./src/embed/api.js"
    },
    "./sim": {
      "types": "./src/embed/sim.d.ts",
      "import": "./src/embed/sim.js",
      "default": "./src/embed/sim.js"
    },
    "./render": {
      "types": "./src/embed/render.d.ts",
      "import": "./src/embed/render.js",
      "default": "./src/embed/render.js"
    },
    "./ca": {
      "types": "./src/embed/ca.d.ts",
      "import": "./src/embed/ca.js",
      "default": "./src/embed/ca.js"
    },
    "./stochastic": {
      "types": "./src/embed/stochastic.d.ts",
      "import": "./src/embed/stochastic.js",
      "default": "./src/embed/stochastic.js"
    },
    "./solid": {
      "types": "./src/embed/solid.d.ts",
      "import": "./src/embed/solid.js",
      "default": "./src/embed/solid.js"
    },
    "./ca-element": {
      "types": "./src/embed/ca-element.d.ts",
      "import": "./src/embed/ca-element.js",
      "default": "./src/embed/ca-element.js"
    },
    "./stochastic-element": {
      "types": "./src/embed/stochastic-element.d.ts",
      "import": "./src/embed/stochastic-element.js",
      "default": "./src/embed/stochastic-element.js"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidem/HexLife.git"
  },
  "bugs": {
    "url": "https://github.com/Sidem/HexLife/issues"
  },
  "homepage": "https://github.com/Sidem/HexLife/blob/main/docs/embed/README.md"
}
